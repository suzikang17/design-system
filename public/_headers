# Cloudflare static assets read this file (it is not served). Syntax:
# https://developers.cloudflare.com/workers/static-assets/headers/
# Rules from every matching block are joined in file order.

# Vite names everything under /assets/ with a content hash, so it can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The site frames its own /client/preview/* pages (same origin); nothing else may frame it.
/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self'
